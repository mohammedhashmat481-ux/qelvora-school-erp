# =================================================================
# QELVORA SCHOOL CRM - AI MICROSERVICE & GATEWAY CONFIGURATION
# =================================================================

# Server Network
PORT=8000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_school_crm_platform_2026
JWT_EXPIRES_IN=7d

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qelvora_school_crm?schema=public"

# =================================================================
# AI QUESTION PAPER GENERATOR PROVIDERS (FREE TIER FIRST)
# =================================================================

# Primary Provider ('gemini' | 'groq' | 'curriculum-engine')
AI_PROVIDER_PRIMARY="gemini"

# Fallback Provider when primary encounters 429/5xx or rate limits
AI_PROVIDER_FALLBACK="groq"

# 1. Google Gemini (Free tier from Google AI Studio)
# Get your free key at: https://aistudio.google.com/
# Recommended Free Model: gemini-1.5-flash or gemini-2.0-flash
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# 2. Groq Cloud (Free tier)
# Get your free key at: https://console.groq.com/
# Recommended Free Model: llama-3.3-70b-versatile
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Mock Provider (Allowed ONLY when ENABLE_MOCK_AI=true AND NODE_ENV=development)
# Every paper produced by mock shows a prominent red banner "SAMPLE DATA – NOT AI GENERATED"
ENABLE_MOCK_AI="false"

# Per-User Rate Limit
AI_RATE_LIMIT_PER_USER_MAX="20"
AI_RATE_LIMIT_PER_USER_WINDOW_MS="3600000"
