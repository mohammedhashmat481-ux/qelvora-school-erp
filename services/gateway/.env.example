# =================================================================
# QELVORA SCHOOL CRM - AI MICROSERVICE & GATEWAY CONFIGURATION
# =================================================================

# Server Network
PORT=8000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_school_crm_platform_2026
JWT_EXPIRES_IN=7d

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qelvora_school_crm?schema=public"

# =================================================================
# AI QUESTION PAPER GENERATOR PROVIDERS (FREE TIER FIRST)
# =================================================================

# Primary Provider ('gemini' | 'groq' | 'curriculum-engine')
AI_PROVIDER_PRIMARY="gemini"

# Fallback Provider when primary encounters 429/5xx or rate limits
AI_PROVIDER_FALLBACK="groq"

# 1. Google Gemini (Free tier from Google AI Studio)
# Get your free key at: https://aistudio.google.com/
# Recommended Free Model: gemini-1.5-flash or gemini-2.0-flash
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# 2. Groq Cloud (Free tier)
# Get your free key at: https://console.groq.com/
# Recommended Free Model: llama-3.3-70b-versatile
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Mock Provider (Allowed ONLY when ENABLE_MOCK_AI=true AND NODE_ENV=development)
# Every paper produced by mock shows a prominent red banner "SAMPLE DATA – NOT AI GENERATED"
ENABLE_MOCK_AI="false"

# Per-User Rate Limit
AI_RATE_LIMIT_PER_USER_MAX="20"
AI_RATE_LIMIT_PER_USER_WINDOW_MS="3600000"

# =================================================================
# QELVORA SCHOOL AI ASSISTANT (VOICE & TEXT SCHOOL-WIDE AGENT)
# =================================================================
# Active Tier ('free' | 'premium'). Switchable in Admin Panel with zero redeployment.
AI_TIER="free"

# Google Gemini API Key (Backend-only, never exposed to client)
GEMINI_API_KEY=""

# Per-Tier LLM Models (Never hardcoded in code; dynamically resolved)
# Free Tier default: gemini-1.5-flash
LLM_MODEL_FREE="gemini-1.5-flash"
# Premium Tier default: Gemini 3.5 Flash (official model ID: gemini-3.5-flash)
LLM_MODEL_PREMIUM="gemini-3.5-flash"

# TTS Providers per tier ('browser' | 'gemini' | 'elevenlabs')
TTS_PROVIDER_FREE="browser"
TTS_PROVIDER_PREMIUM="gemini"

# Optional ElevenLabs integration for Premium Tier
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# Natural Voice Choice per Language (English, Hindi, Kannada)
AI_VOICE_EN="en-US-Journey-F"
AI_VOICE_HI="hi-IN-Neural2-D"
AI_VOICE_KN="kn-IN-Standard-A"

# Daily Quota & Cost Control
AI_USER_LIMIT_FREE="50"
AI_USER_LIMIT_PREMIUM="200"
AI_SCHOOL_LIMIT_FREE="500"
AI_SCHOOL_LIMIT_PREMIUM="5000"
AI_CACHE_TTL_SEC="60"


